[Unit]
Description=Plaude-like backend API
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/storage-apps/www/sonora/current/backend
EnvironmentFile=/storage-apps/www/sonora/shared/backend.env
ExecStart=/usr/bin/env node dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
